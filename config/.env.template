# AI Pipeline + Hook Environment Configuration
#
# 啟用前環境設定：複製本檔為 .env 並填入憑證。未設定時骨架以降級模式執行
# （fetch_sources 會將各來源標記 not_configured，pipeline 仍可整條跑通）。

# Obsidian
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Google Calendar (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Notion
NOTION_INTEGRATION_TOKEN=
NOTION_TASKS_DATABASE_ID=

# GitHub
GITHUB_TOKEN=

# Notification (optional)
SLACK_WEBHOOK=
NTFY_URL=
